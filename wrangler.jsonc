// Cloudflare Workers 배포 설정.
// - 사이트: dist/ 의 정적 파일(정적 자산 요청은 Worker 코드를 거치지 않아 CPU 를 쓰지 않음).
// - cron/worker.js: 정해진 시각(KST 23:05, 06:00, 07:00, 09:30, 13:00, 18:00, 19:00, 22:00)에
//   GitHub Actions '매일 분석'을 시작한다. 19:20 은 알림 보내기.
//   무료 계정은 예약 실행이 계정 전체 5개까지(다른 Worker 와 공유)라, 5분마다 하나만 두고 시각 판단은 worker.js 의 SCHEDULE 표에서 한다.
{
  "name": "sports-report",
  "main": "cron/worker.js",
  "compatibility_date": "2026-11-01",
  // 예약 실행·알림 로그를 Cloudflare 대시보드(Workers → sports-report → Logs)에서 볼 수 있게
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // 모든 요청이 Worker를 먼저 거쳐 http·슬래시 없는 주소를 301로 하나로 모은다(방문 규모상 무료 한도 여유)
    "run_worker_first": true
  },
  // 비공개 저장소(KV sports-report-kv): 알림 구독, 서명 키, 쓰레드 토큰(7일마다 자동 연장)
  "kv_namespaces": [{ "binding": "PUSH", "id": "cd2febbe3e794d71a7072a3fff0f693b" }],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
